# grower-service — every variable the service reads (SPEC-PLAT-06 R78). Copy to .env (git-ignored).
# Values below are DEV-ONLY and target the growercare-local-platform network (container hostnames).
# Production: injected from AWS Secrets Manager via External Secrets (never committed).

# --- required (no defaults; the service refuses to start without them)
# JDBC URL of the sharded gc_grower database
DB_URL=jdbc:postgresql://postgres:5432/gc_grower
# runtime role (DML only) and its password (secret)
DB_APP_USER=gc_grower_app
DB_APP_PASSWORD=dev_grower_app_pw
# Debezium login role granted on every shard outbox (migrations)
GC_CDC_ROLE=gc_cdc
# expected token issuer (iss claim), where signing keys are fetched, where service tokens are requested
OIDC_ISSUER_URI=http://localhost:8180/realms/growercare
OIDC_JWKS_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/certs
OIDC_TOKEN_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/token
# identity-access-service (network only) and this service's Keycloak client for /internal calls (secret)
IAM_BASE_URL=http://identity-access-service:8081
# notification-service, which sends one-time codes (SPEC-GRW-03 D2)
NOTIFICATION_BASE_URL=http://notification-service:8085
IAM_CLIENT_ID=grower-service
IAM_CLIENT_SECRET=dev-grower-service-secret
# Keycloak clients allowed on /internal/** (SPEC-GRW-01 R42: case-service reads the replica view)
GC_INTERNAL_CLIENTS=case-service,notification-service
# of those, the clients that may read a grower's phone (SPEC-GRW-07 D1)
GC_CONTACT_CLIENTS=notification-service
# of those, the clients that may read the grower and farm replica views (case-service's replicas)
GC_REPLICA_CLIENTS=case-service
# principal cache (Redis is never a system of record)
REDIS_HOST=redis
REDIS_PASSWORD=dev_redis_pw
# SPEC-GRW-01 D3: phone HMAC key and AES-256-GCM key (base64, 32 bytes each; secrets) and the encryption key's id.
# DEV-ONLY keys. Generate real ones with: openssl rand -base64 32
GC_PHONE_HMAC_KEY=ZGV2LW9ubHktcGhvbmUtaG1hYy1rZXktMzItYnl0ZXM=
GC_PHONE_ENC_KEY=ZGV2LW9ubHktcGhvbmUtZW5jcnlwdGlvbi1rZXktMzI=
GC_PHONE_ENC_KEY_ID=dev-1

# --- migrations (only where they run: locally, or the pre-deploy Job)
# default false
GC_MIGRATE=true
DB_OWNER_USER=gc_grower_owner
DB_OWNER_PASSWORD=dev_grower_owner_pw
# territories, partners, growers (local only); default false
GC_DEV_SEED=true
GC_MIGRATE_PARALLELISM=8

# --- optional tunables (safe defaults)
SERVER_PORT=8084
DB_POOL_SIZE=20
REDIS_PORT=6379
# default: none
GC_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Swagger UI only locally; default false
GC_API_DOCS_ENABLED=true
JAVA_TOOL_OPTIONS=-Xmx512m
